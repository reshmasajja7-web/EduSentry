PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edusentry
JWT_SECRET=replace_this_with_a_long_random_secret
NODE_ENV=development

# Password reset email (Gmail SMTP example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Real SMS Gateway Configuration for Phone OTP Delivery
# Fast2SMS (India Quick SMS) - https://www.fast2sms.com
FAST2SMS_API_KEY=
# 2Factor.in (India SMS) - https://2factor.in
TWOFACTOR_API_KEY=
# Twilio (Global SMS) - https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# AI Tutor providers: free-tier eligible options only (limits and availability can change).
# Never add keys to VITE_ variables or browser storage. Do not enable paid billing.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=


# Additional AI providers (only use endpoints/quota explicitly available for free)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Ollama is local; install Ollama, pull a model (e.g. `ollama pull llama3.2`), and run it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite
