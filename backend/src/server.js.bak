const app = express()

const PORT = Number(process.env.PORT || 5000)

const FRONTEND_URL =
  process.env.FRONTEND_URL || 'http://localhost:5173'

const smtpConfigured =
  Boolean(process.env.SMTP_USER) &&
  Boolean(process.env.SMTP_PASS)

const mailTransporter = smtpConfigured
  ? nodemailer.createTransport(
      process.env.SMTP_HOST
        ? {
            host: process.env.SMTP_HOST,
            port: Number(process.env.SMTP_PORT || 587),
            secure:
              process.env.SMTP_SECURE !== undefined
                ? String(process.env.SMTP_SECURE) === 'true'
                : Number(process.env.SMTP_PORT) === 465,
            auth: {
              user: process.env.SMTP_USER,
              pass: process.env.SMTP_PASS,
            },
            tls: {
              rejectUnauthorized:
                process.env.SMTP_TLS_REJECT_UNAUTHORIZED !== 'false',
            },
          }
        : {
            service: 'gmail',
            auth: {
              user: process.env.SMTP_USER,
              pass: process.env.SMTP_PASS,
            },
          }
    )
  : null

if (smtpConfigured && mailTransporter) {
  mailTransporter.verify((err) => {
    if (err) {
      console.warn('⚠️  [SMTP] Email transport verification failed:', err.message)
    } else {
      console.log('✅ [SMTP] Email transport ready to dispatch verification codes directly to mail inboxes.')
    }
  })
}

async function sendPasswordOtpEmail(email, otp) {
  if (!mailTransporter) {
    throw new Error(
      'Email service (SMTP) is not configured in backend/.env. Please configure SMTP_USER and SMTP_PASS.'
    )
  }

  const senderFrom =
    process.env.SMTP_FROM || `"EduSentry Security" <${process.env.SMTP_USER}>`

  await mailTransporter.sendMail({
    from: senderFrom,
    to: email,
    subject: '🛡️ EduSentry Password Reset Verification Code',
    text: `Your EduSentry 6-digit verification code is: ${otp}\n\nThis code is valid for 15 minutes.\nIf you did not request a password reset, please secure your account immediately or ignore this email.`,
    html: `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <style>
          body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #060b13; color: #e2e8f0; margin: 0; padding: 30px 15px; }
          .container { max-width: 540px; margin: 0 auto; background: #0c1527; border: 1px solid #1e293b; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.5); }
          .header { background: linear-gradient(135deg, #0e1d38 0%, #081120 100%); padding: 28px 32px; border-bottom: 1px solid #1e2e4a; text-align: center; }
          .brand { font-size: 22px; font-weight: 800; color: #ffffff; letter-spacing: 1px; display: inline-flex; align-items: center; gap: 8px; }
          .brand-badge { background: #f5b722; color: #060b13; font-size: 11px; font-weight: 800; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; }
          .content { padding: 32px; color: #cbd5e1; font-size: 15px; line-height: 1.6; }
          .title { font-size: 20px; font-weight: 700; color: #ffffff; margin-top: 0; margin-bottom: 14px; }
          .otp-card { margin: 26px 0; padding: 22px; background: #111e35; border: 1px solid #283e65; border-radius: 12px; text-align: center; }
          .otp-label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; color: #f5b722; margin-bottom: 8px; }
          .otp-code { font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace; font-size: 38px; font-weight: 800; letter-spacing: 10px; color: #ffffff; margin: 6px 0; }
          .otp-expiry { font-size: 12px; color: #94a3b8; margin-top: 6px; }
          .warning { font-size: 13px; color: #94a3b8; border-top: 1px solid #1e293b; padding-top: 18px; margin-top: 24px; line-height: 1.5; }
          .footer { background: #080e1a; padding: 18px 32px; text-align: center; font-size: 12px; color: #64748b; border-top: 1px solid #172338; }
        </style>
      </head>
      <body>
        <div class="container">
          <div class="header">
            <div class="brand">
              🛡️ EDUSENTRY <span class="brand-badge">SECURE</span>
            </div>
          </div>
          <div class="content">
            <h2 class="title">Password Reset Verification</h2>
            <p>Hello,</p>
            <p>We received a request to reset the password for your EduSentry account (<strong>${email}</strong>). Use the 6-digit verification code below to complete the verification process:</p>
            
            <div class="otp-card">
              <div class="otp-label">Verification Code</div>
              <div class="otp-code">${otp}</div>
              <div class="otp-expiry">⏱️ Valid for 15 minutes. Single-use only.</div>
            </div>

            <p>Enter this verification code on the EduSentry password reset page to set your new password.</p>

            <div class="warning">
              🔒 <strong>Security Warning:</strong> EduSentry staff will never ask you for this code. If you did not make this request, please disregard this email or check your account security settings.
            </div>
          </div>
          <div class="footer">
            &copy; ${new Date().getFullYear()} EduSentry Platform. All rights reserved.
          </div>
        </div>
      </body>
      </html>
    `,
  })
}

