const asyncRoute = (fn) => (req, res, next) =>
  Promise.resolve(fn(req, res, next)).catch(next)

// ============================================================
// HELPERS
// ============================================================

// In-memory store for phone verification OTPs (phone -> code)
const phoneOtpStore = new Map()

function publicUser(row) {
  return {
    id: row.id,
    name: row.name,
    email: row.email,
    phone: row.phone || null,
    role: row.role,
    course: row.course,
    careerGoal: row.career_goal,
    createdAt: row.created_at,
  }
}

/*
 * PostgreSQL JSON/JSONB helper.
 *
 * This is important for Career Guidance because arrays such as:
 *
 * ["Performing Arts", "Technology"]
 *
 * must be inserted as valid JSON.
 */
function toJson(value, fallback = null) {
  if (value === undefined || value === null) {
    return fallback
  }

  if (typeof value === 'string') {
    try {
      JSON.parse(value)
      return value
    } catch {
      return JSON.stringify(value)
    }
  }

  return JSON.stringify(value)
}

