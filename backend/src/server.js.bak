app.post(
  '/api/auth/register',
  asyncRoute(async (req, res) => {
    const {
      name,
      email,
      phone,
      password,
      role = 'student',
    } = req.body

    if (!name?.trim() || !email?.trim() || !phone?.trim() || !password) {
      return res.status(400).json({
        error: 'Name, email, phone number and password are required.',
      })
    }

    const emailValidation = validateEmailSyntax(email)
    if (!emailValidation.valid) {
      return res.status(400).json({ error: 'Enter a valid email address.' })
    }
    const normalizedEmail = emailValidation.normalized

    const passwordError = passwordValidationError(password)
    if (passwordError) {
      return res.status(400).json({ error: passwordError })
    }

    // Check domain mail routing where DNS is available. This cannot prove that
    // an individual inbox exists; that would require inbox verification.
    try {
      const mx = await resolveMx(emailValidation.domain)
      if (!Array.isArray(mx) || mx.length === 0) {
        return res.status(400).json({ error: 'This email domain does not appear to accept email. Check the address and try again.' })
      }
    } catch (dnsError) {
      if (dnsError?.code === 'ENOTFOUND' || dnsError?.code === 'ENODATA' || dnsError?.code === 'ENOTIMP') {
        return res.status(400).json({ error: 'This email domain does not appear to accept email. Check the address and try again.' })
      }
      // Transient DNS/network failures should not falsely reject a valid address.
      console.warn('[Registration] Could not verify email-domain mail records:', dnsError?.code || dnsError?.message)
    }

    const phoneValidation = normalizeIndianPhone(phone)
    if (!phoneValidation.valid) {
      return res.status(400).json({ error: 'Enter a valid Indian mobile number, e.g. +91 98765 43210.' })
    }
    const cleanPhone = phoneValidation.phone

    const exists = await query(
      'SELECT id FROM users WHERE email = $1',
      [normalizedEmail]
    )

    if (exists.rowCount) {
      return res.status(409).json({
        error: 'An account with this email already exists.',
      })
    }

    if (cleanPhone) {
      const phoneExists = await query(
        'SELECT id FROM users WHERE phone = $1',
        [cleanPhone]
      )
      if (phoneExists.rowCount) {
        return res.status(409).json({
          error: 'An account with this phone number already exists.',
        })
      }
    }

    const passwordHash = await bcrypt.hash(password, 12)

    const result = await query(
      `
      INSERT INTO users
        (name, email, phone, password_hash, role)
      VALUES
        ($1, $2, $3, $4, $5)
      RETURNING *
      `,
      [
        name.trim(),
        normalizedEmail,
        cleanPhone,
        passwordHash,
        role,
      ]
    )

    const user = publicUser(result.rows[0])

    setAuthCookie(res, signToken(user))

    res.status(201).json({ user })
  })
)

// Request SMS/Phone Verification Code (OTP)
app.post(
  '/api/auth/phone-otp',
  asyncRoute(async (req, res) => {
    const { phone } = req.body
    if (!phone?.trim()) {
      return res.status(400).json({ error: 'Phone number is required.' })
    }
    const cleanPhone = phone.trim().replace(/[\s\-\(\)]/g, '')
    // Generate a genuine 6-digit random verification code
    const generatedOtp = Math.floor(100000 + Math.random() * 900000).toString()
    phoneOtpStore.set(cleanPhone, generatedOtp)
    setTimeout(() => phoneOtpStore.delete(cleanPhone), 10 * 60 * 1000)

    // Dispatch real SMS to the target phone number via SMS Gateway
    const smsResult = await sendSmsOtp({ phone: cleanPhone, otp: generatedOtp })

    res.json({
      ok: true,
      delivered: smsResult.delivered,
      provider: smsResult.provider,
      message: `A 6-digit verification code has been dispatched to ${cleanPhone}. Please check your SMS messages.`,
    })
  })
)

app.post(
  '/api/auth/login',
  asyncRoute(async (req, res) => {
    const { email, phone, identifier, password, otp } = req.body
    const rawLogin = (identifier || phone || email || '').trim()

    if (!rawLogin) {
      return res.status(400).json({
        error: 'Email or phone number is required.',
      })
    }

    const cleanPhone = rawLogin.replace(/[\s\-\(\)]/g, '')

    // Phone + OTP instant verification login
    if (otp) {
      const cachedOtp = phoneOtpStore.get(cleanPhone)
      if (!cachedOtp || cachedOtp !== otp.trim()) {
        return res.status(400).json({
          error: 'Invalid or expired verification code. Please check your phone SMS and enter the 6-digit code received.',
        })
      }

      // Check if user exists with this phone
      let result = await query(
        `SELECT * FROM users 
         WHERE phone = $1 
            OR phone = $2 
            OR REPLACE(REPLACE(phone, ' ', ''), '-', '') = $2`,
        [rawLogin, cleanPhone]
      )

      let found = result.rows[0]
      if (!found) {
        // Auto-provision user account for phone login
        const autoName = 'Student ' + cleanPhone.slice(-4)
        const autoEmail = `student_${Date.now()}@edusentry.edu`
        const dummyHash = await bcrypt.hash('phone_' + Date.now(), 10)
        const insertRes = await query(
          `INSERT INTO users (name, email, phone, password_hash, role)
           VALUES ($1, $2, $3, $4, 'student')
           RETURNING *`,
          [autoName, autoEmail, rawLogin, dummyHash]
        )
        found = insertRes.rows[0]
      }

      phoneOtpStore.delete(cleanPhone)
      const user = publicUser(found)
      setAuthCookie(res, signToken(user))
      return res.json({ user })
    }

    // Password-based login (supports Email OR Phone number)
    if (!password) {
      return res.status(400).json({
        error: 'Password is required.',
      })
    }

    const normalizedEmail = rawLogin.toLowerCase()

    const result = await query(
      `SELECT * FROM users 
       WHERE email = $1 
          OR phone = $1 
          OR phone = $2 
          OR REPLACE(REPLACE(phone, ' ', ''), '-', '') = $2`,
      [normalizedEmail, cleanPhone]
    )

    const found = result.rows[0]

    if (
      !found ||
      !(await bcrypt.compare(
        password,
        found.password_hash
      ))
    ) {
      return res.status(401).json({
        error: 'Incorrect email/phone number or password.',
      })
    }

    const user = publicUser(found)

    setAuthCookie(res, signToken(user))

    res.json({ user })
  })
)

app.post('/api/auth/logout', (_req, res) => {
  clearAuthCookie(res)

  res.json({ ok: true })
})

app.get(
  '/api/auth/me',
  requireAuth,
  asyncRoute(async (req, res) => {
    const result = await query(
      'SELECT * FROM users WHERE id = $1',
      [req.auth.sub]
    )

    if (!result.rowCount) {
      return res.status(404).json({
        error: 'User not found.',
      })
    }

    res.json({
      user: publicUser(result.rows[0]),
    })
  })
)

app.put(
  '/api/auth/profile',
  requireAuth,
  asyncRoute(async (req, res) => {
    const {
      name,
      course,
      careerGoal,
      phone,
    } = req.body

    const result = await query(
      `
      UPDATE users
      SET
        name = COALESCE($1, name),
        course = $2,
        career_goal = $3,
        phone = COALESCE($4, phone),
        updated_at = NOW()
      WHERE id = $5
      RETURNING *
      `,
      [
        name?.trim() || null,
        course ?? null,
        careerGoal ?? null,
        phone?.trim() || null,
        req.auth.sub,
      ]
    )

    res.json({
      user: publicUser(result.rows[0]),
    })
  })
)

app.post(
  '/api/auth/change-password',
  requireAuth,
  asyncRoute(async (req, res) => {
    const {
      currentPassword,
      newPassword,
    } = req.body

    const newPasswordError = passwordValidationError(newPassword)
    if (newPasswordError) {
      return res.status(400).json({ error: newPasswordError.replace('Password', 'New password') })
    }

    const result = await query(
      'SELECT password_hash FROM users WHERE id = $1',
      [req.auth.sub]
    )

    if (
      !result.rowCount ||
      !(await bcrypt.compare(
        currentPassword || '',
        result.rows[0].password_hash
      ))
    ) {
      return res.status(400).json({
        error: 'Current password is incorrect.',
      })
    }

    const hash = await bcrypt.hash(
      newPassword,
      12
    )

    await query(
      `
      UPDATE users
      SET
        password_hash = $1,
        updated_at = NOW()
      WHERE id = $2
      `,
      [hash, req.auth.sub]
    )

    res.json({ ok: true })
  })
)

app.post(
  '/api/auth/forgot-password',
  asyncRoute(async (req, res) => {
    const email = req.body.email?.trim().toLowerCase()

    if (!email) {
      return res.status(400).json({
        error: 'Email address is required.',
      })
    }

    const result = await query(
      'SELECT id, name FROM users WHERE LOWER(email) = LOWER($1)',
      [email]
    )

    if (!result.rowCount) {
      return res.status(404).json({
        error: 'No EduSentry account found with this email. Please check your spelling or register a new account.',
      })
    }

    const userId = result.rows[0].id
    const otp = String(
      crypto.randomInt(100000, 1000000)
    )
    const otpHash = crypto
      .createHash('sha256')
      .update(otp)
      .digest('hex')

    await query(
      `
      DELETE FROM password_reset_tokens
      WHERE user_id = $1
         OR expires_at < NOW()
      `,
      [userId]
    )

    await query(
      `
      INSERT INTO password_reset_tokens
        (user_id, token_hash, expires_at)
      VALUES
        ($1, $2, NOW() + INTERVAL '15 minutes')
      `,
      [userId, otpHash]
    )

    let emailDelivered = false
    let mailErrorMsg = null

    if (smtpConfigured && mailTransporter) {
      try {
        await sendPasswordOtpEmail(email, otp)
        emailDelivered = true
        console.log(`[PASSWORD RESET] Verification email successfully dispatched to ${email}`)
      } catch (mailError) {
        mailErrorMsg = mailError.message
        console.warn('[PASSWORD RESET] SMTP dispatch failed, fallback to server mail log:', mailError.message)
      }
    }

    // Always log clean email dispatch details in server console
    console.log('\n============================================================')
    console.log(`📧 [EMAIL NOTIFICATION] EduSentry Password Reset`)
    console.log(`To: ${email}`)
    console.log(`Subject: 🛡️ EduSentry Password Reset Verification Code`)
    console.log(`Verification Code: ${otp}`)
    console.log(`Status: ${emailDelivered ? 'Delivered via SMTP' : 'Queued (SMTP offline or in dev mode)'}`)
    console.log('============================================================\n')

    res.json({
      ok: true,
      emailDelivered,
      message: `A 6-digit verification code has been dispatched to ${email}. Please check your inbox.`,
    })
  })
)

app.post(
  '/api/auth/verify-otp',
  asyncRoute(async (req, res) => {
    const email = req.body.email?.trim().toLowerCase()
    const otp = String(req.body.otp || '').trim()

    if (!email || !/^\d{6}$/.test(otp)) {
      return res.status(400).json({
        error: 'Enter the 6-digit verification code sent to your email.',
      })
    }

    const userResult = await query(
      'SELECT id FROM users WHERE LOWER(email) = LOWER($1)',
      [email]
    )

    if (!userResult.rowCount) {
      return res.status(400).json({
        error: 'The verification code is invalid or expired.',
      })
    }

    const tokenResult = await query(
      `
      SELECT id, user_id, token_hash
      FROM password_reset_tokens
      WHERE user_id = $1
        AND used_at IS NULL
        AND expires_at > NOW()
      ORDER BY created_at DESC
      LIMIT 1
      `,
      [userResult.rows[0].id]
    )

    if (!tokenResult.rowCount) {
      return res.status(400).json({
        error: 'The verification code has expired. Please request a new code.',
      })
    }

    const suppliedHash = crypto
      .createHash('sha256')
      .update(otp)
      .digest('hex')

    const storedHash = tokenResult.rows[0].token_hash

    if (
      suppliedHash.length !== storedHash.length ||
      !crypto.timingSafeEqual(
        Buffer.from(suppliedHash),
        Buffer.from(storedHash)
      )
    ) {
      return res.status(400).json({
        error: 'Incorrect verification code. Please check the 6-digit code and try again.',
      })
    }

    // Replace the one-time OTP with a high-entropy reset token.
    // The user must successfully verify the OTP before this token exists.
    const resetToken = crypto.randomBytes(32).toString('hex')
    const resetTokenHash = crypto
      .createHash('sha256')
      .update(resetToken)
      .digest('hex')

    await query(
      `
      UPDATE password_reset_tokens
      SET
        token_hash = $1,
        expires_at = NOW() + INTERVAL '10 minutes'
      WHERE id = $2
      `,
      [resetTokenHash, tokenResult.rows[0].id]
    )

    res.json({
      ok: true,
      resetToken,
      message: 'Code verified. You can now choose a new password.',
    })
  })
)

app.post(
  '/api/auth/reset-password',
  asyncRoute(async (req, res) => {
    const { resetToken, newPassword } = req.body

    if (!resetToken) {
      return res.status(400).json({ error: 'A valid verification session is required.' })
    }
    const newPasswordError = passwordValidationError(newPassword)
    if (newPasswordError) {
      return res.status(400).json({ error: newPasswordError.replace('Password', 'New password') })
    }

    const tokenHash = crypto
      .createHash('sha256')
      .update(resetToken)
      .digest('hex')

    const result = await query(
      `
      SELECT *
      FROM password_reset_tokens
      WHERE token_hash = $1
        AND used_at IS NULL
        AND expires_at > NOW()
      `,
      [tokenHash]
    )

    if (!result.rowCount) {
      return res.status(400).json({
        error:
          'The verification session is invalid or expired. Please request a new code.',
      })
    }

    const hash = await bcrypt.hash(newPassword, 12)

    await query(
      `
      UPDATE users
      SET
        password_hash = $1,
        updated_at = NOW()
      WHERE id = $2
      `,
      [hash, result.rows[0].user_id]
    )

    await query(
      `
      UPDATE password_reset_tokens
      SET used_at = NOW()
      WHERE id = $1
      `,
      [result.rows[0].id]
    )

    res.json({
      ok: true,
      message: 'Your password has been reset successfully.',
    })
  })
)

