      FROM tutor_messages
      WHERE user_id = $1
      ORDER BY created_at ASC
      LIMIT 200
      `,
      [req.auth.sub]
    )

    res.json({
      messages: result.rows,
    })
  })
)

// ============================================================
// RAG & MULTI-LLM APIS
// ============================================================

app.get(
  '/api/rag/models',
  (_req, res) => {
    res.json({
      models: SUPPORTED_RAG_MODELS,
      hasServerGeminiKey: Boolean(process.env.GEMINI_API_KEY),
      hasServerGroqKey: Boolean(process.env.GROQ_API_KEY),
      hasServerOpenRouterKey: Boolean(process.env.OPENROUTER_API_KEY),
      configuredProviders: { gemini: Boolean(process.env.GEMINI_API_KEY), groq: Boolean(process.env.GROQ_API_KEY), openrouter: Boolean(process.env.OPENROUTER_API_KEY), mistral: Boolean(process.env.MISTRAL_API_KEY), nvidia: Boolean(process.env.NVIDIA_NIM_API_KEY), cloudflare: Boolean(process.env.CLOUDFLARE_API_TOKEN && process.env.CLOUDFLARE_ACCOUNT_ID), ollama: true },
    })
  }
)


function selectRelevantDocumentContext(question, docs, topK = 4) {
  const terms = [...new Set(String(question).toLowerCase().match(/[a-z0-9_+-]{3,}/g) || [])]
  if (!terms.length || !Array.isArray(docs)) return []
  const chunks = []
  for (const doc of docs.slice(0, 30)) {
    const fileName = String(doc?.fileName || doc?.name || 'Uploaded document').slice(0, 200)
    const text = String(doc?.text || '').slice(0, 100000)
    // Paragraph-level retrieval keeps context relevant and bounded.
    const paragraphs = text.split(/\n\s*\n/).map((value) => value.trim()).filter(Boolean)
    for (const paragraph of paragraphs) {
      const normalized = paragraph.toLowerCase()
      const score = terms.reduce((sum, term) => sum + (normalized.includes(term) ? 1 : 0), 0)
      if (score > 0) chunks.push({ fileName, text: paragraph.slice(0, 1800), score })
    }
  }
  return chunks.sort((a, b) => b.score - a.score).slice(0, Math.max(1, Math.min(Number(topK) || 4, 8)))
}

function makeTutorSystemPrompt(mode, context) {
  const basePrompt = [
    'You are EduSentry, a capable, friendly, general-purpose AI assistant and learning tutor.',
    'Answer the user’s actual question, not only questions about uploaded documents.',
    'Handle topic changes naturally and use conversation history for follow-up questions.',
    'Be accurate and candid about uncertainty. Never invent facts, citations, tools, or document contents.',
    'Use clear Markdown, headings and code blocks when useful. Explain technical ideas in a student-friendly way.',
    'For programming questions, provide runnable examples when appropriate and explain important parts.',
  ].join(' ')
  if (mode === 'socratic') {
    return `${basePrompt} Use a Socratic teaching style: explain enough to help, then end with one useful question that checks understanding.`
  }
  if (mode === 'strict') {
    return `${basePrompt} The user requested strict academic grounding. If relevant uploaded-document context is provided, answer only from that context and explicitly say when it does not contain the answer. If no relevant context is provided, state that the uploaded documents do not cover the question; do not substitute outside knowledge.`
  }
  return context.length
    ? `${basePrompt} Uploaded-document excerpts are provided as supplemental context. Use them when relevant, but you may also answer general questions from your model knowledge. Do not claim a document supports a fact unless the excerpt actually does.`
    : basePrompt
}

app.post(
  '/api/rag/generate',
  requireAuth,
  asyncRoute(async (req, res) => {
    const { question, history = [], docs = [], contextChunks, modelId = 'edusentry-neural', mode = 'pedagogical', topK = 4 } = req.body || {}
    if (typeof question !== 'string' || !question.trim()) {
      return res.status(400).json({ error: 'Enter a message before sending.' })
    }
    if (question.length > 12000) {
      return res.status(413).json({ error: 'Your message is too long. Please shorten it and try again.' })
    }
    if (!Array.isArray(history) || !Array.isArray(docs)) {
      return res.status(400).json({ error: 'Conversation history and documents must be lists.' })
    }

    const context = Array.isArray(contextChunks)
      ? contextChunks.slice(0, Math.max(1, Math.min(Number(topK) || 4, 8)))
          .filter((chunk) => typeof chunk?.text === 'string' && chunk.text.trim())
          .map((chunk) => ({
            fileName: String(chunk.fileName || 'Uploaded document').slice(0, 200),
            text: String(chunk.text).slice(0, 1800),
            score: Number(chunk.score) || 0,
            id: String(chunk.id || ''),
          }))
      : selectRelevantDocumentContext(question, docs, topK)
    const contextText = context.map((chunk, index) =>
      `[Excerpt ${index + 1} | Source: ${chunk.fileName}]\n${chunk.text}`
    ).join('\n\n---\n\n')

    if (mode === 'strict' && !context.length) {
      return res.json({
        text: 'I could not find relevant information for this question in your uploaded documents. In Strict Academic Grounding mode, I only answer from relevant uploaded material. Switch to Deep Tutor mode for a general answer.',
        citations: [],
        model: 'Document-grounded response',
        suggestedQuestions: [],
      })
    }

    if (modelId === 'edusentry-neural') {
      if (!context.length) {
        return res.status(503).json({
          error: 'The built-in offline mode retrieves uploaded notes only. For general-purpose answers, configure a free-tier eligible Groq or Gemini API key in backend/.env and select that model.',
          code: 'MODEL_NOT_CONFIGURED',
        })
      }
      const snippets = context.map((chunk) => `**${chunk.fileName}:** ${chunk.text}`).join('\n\n')
      return res.json({
        text: `### From your uploaded material\n\n${snippets}\n\n*This response is retrieved from your uploaded documents; it was not generated by an external language model.*`,
        citations: context.map((chunk, index) => ({ id: index + 1, fileName: chunk.fileName, excerpt: chunk.text.slice(0, 220), score: chunk.score })),
        model: 'EduSentry Neural RAG',
        suggestedQuestions: [],
      })
    }

    const config = RAG_MODEL_CONFIG[modelId]
    if (!config) return res.status(400).json({ error: 'The selected AI model is not supported.' })
    const apiKey = config.envKey ? process.env[config.envKey] : null
    if (config.provider === 'cloudflare' && !process.env.CLOUDFLARE_ACCOUNT_ID) {
      return res.status(503).json({ error: 'Add CLOUDFLARE_ACCOUNT_ID to backend/.env to use Cloudflare Workers AI.', code: 'MODEL_NOT_CONFIGURED' })
    }
    if (config.envKey && !apiKey) {
      return res.status(503).json({
        error: `${modelId} is not configured on the server. Add ${config.envKey} to backend/.env, restart the backend, and try again.`,
        code: 'MODEL_NOT_CONFIGURED',
      })
    }

    try {
      const result = await generateWithProvider(config, apiKey, modelId, makeTutorSystemPrompt(mode, context), history, question.trim(), contextText)
      return res.json({
        ...result,
        citations: context.map((chunk, index) => ({ id: index + 1, fileName: chunk.fileName, excerpt: chunk.text.slice(0, 220), score: chunk.score })),
        suggestedQuestions: [
          'Can you explain this with a simple example?',
          'What are the key points I should remember?',
        ],
      })
    } catch (error) {
      console.error(`[RAG] ${modelId} generation failed:`, error?.message || error)
      // Try the other configured free-tier provider once so a temporary outage
      // from one service does not leave the tutor unusable.
      const fallbackIds = ['gemini-flash-lite', 'groq-gpt-oss-20b', 'openrouter-free-auto', 'cloudflare-llama', 'mistral-small-free', 'nvidia-nim-llama', 'ollama-local'].filter((id) => id !== modelId)
      for (const fallbackId of fallbackIds) {
        const fallbackConfig = RAG_MODEL_CONFIG[fallbackId]
        const fallbackKey = fallbackConfig?.envKey ? process.env[fallbackConfig.envKey] : null
        if (!fallbackConfig || (fallbackConfig.envKey && !fallbackKey) || (fallbackConfig.provider === 'cloudflare' && !process.env.CLOUDFLARE_ACCOUNT_ID)) continue
        try {
          const fallbackResult = await generateWithProvider(
            fallbackConfig, fallbackKey, fallbackId,
            makeTutorSystemPrompt(mode, context), history, question.trim(), contextText
          )
          console.warn(`[RAG] Served ${modelId} request through fallback ${fallbackId}.`)
          return res.json({
            ...fallbackResult,
            fallback: true,
            citations: context.map((chunk, index) => ({ id: index + 1, fileName: chunk.fileName, excerpt: chunk.text.slice(0, 220), score: chunk.score })),
            suggestedQuestions: ['Can you explain this with a simple example?', 'What are the key points I should remember?'],
          })
        } catch (fallbackError) {
          console.error(`[RAG] Fallback ${fallbackId} failed:`, fallbackError?.message || fallbackError)
        }
      }
      const timedOut = error?.name === 'AbortError'
      return res.status(timedOut ? 504 : 502).json({
        error: timedOut
          ? 'Both the selected AI model and any configured fallback took too long to respond. Please retry in a moment.'
          : `The selected AI model could not generate a response: ${error?.message || 'provider error'}. If another free-tier key is configured, EduSentry tried it as a fallback too.`,
        code: timedOut ? 'MODEL_TIMEOUT' : 'MODEL_PROVIDER_ERROR',
      })
    }
  })
)

app.post(
  '/api/rag/chat',
  optionalAuth,
  asyncRoute(async (req, res) => {
    const { question, answer, citation, modelId = 'edusentry-neural' } = req.body

    if (!question || !answer) {
      return res.status(400).json({ error: 'Question and answer are required.' })
    }

    let savedRecord = null
    if (req.auth?.sub) {
      const result = await query(
        `
        INSERT INTO tutor_messages
          (user_id, question, answer, citation)
        VALUES
          ($1, $2, $3, $4)
        RETURNING
          id, question, answer, citation, created_at
        `,
        [req.auth.sub, question, answer, citation || null]
      )
      savedRecord = result.rows[0]
    }

    res.status(200).json({
      ok: true,
      modelId,
      message: savedRecord || {
        id: 'guest-' + Date.now(),
        question,
        answer,
        citation,
        created_at: new Date().toISOString(),
      },
    })
  })
)

// ============================================================
// 404
// ============================================================

app.use(
  (req, res) => {
    res.status(404).json({
      error:
        `Route ${req.method} ${req.originalUrl} not found.`,
    })
  }
)

// ============================================================
// ERROR HANDLER
// ============================================================

app.use(
  (err, _req, res, _next) => {
    console.error(err)

    res.status(500).json({
      error: 'Internal server error.',
    })
  }
)

// ============================================================
// DATABASE INITIALIZATION
// ============================================================

const __filename =
  fileURLToPath(import.meta.url)

const __dirname =
  path.dirname(__filename)

async function initializeDatabase() {
  const schemaPath =
    path.join(
      __dirname,
      '..',
      'sql',
      'schema.sql'
    )

  const schema =
    await fs.readFile(
      schemaPath,
      'utf8'
    )

  await pool.query(schema)

  console.log(
    'EduSentry database schema is ready.'
  )
}

// ============================================================
// START SERVER
// ============================================================

let server

async function startServer() {
  try {
    await initializeDatabase()

    server = app.listen(
      PORT,
      '0.0.0.0',
      () => {
        console.log(
          `EduSentry API running at http://0.0.0.0:${PORT}`
        )
      }
    )
  } catch (error) {
    console.error(
      'Could not initialize the EduSentry database:',
      error
    )

    await pool.end()

    process.exit(1)
  }
}

// ============================================================
// SHUTDOWN
// ============================================================

async function shutdown() {
  if (server) {
    server.close(
      async () => {
        await pool.end()
        process.exit(0)
      }
    )
  } else {
    await pool.end()
    process.exit(0)
  }
}

process.on(
  'SIGINT',
  shutdown
)

process.on(
  'SIGTERM',
  shutdown
)

startServer()
