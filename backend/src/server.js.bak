// ============================================================
// CAREER GUIDANCE
// ============================================================

app.post(
  '/api/career/results',
  requireAuth,
  asyncRoute(async (req, res) => {
    const {
      selectedInterests = [],
      inputText = '',
      career,
      matchPercent,
    } = req.body

    // --------------------------------------------------------
    // Validate career
    // --------------------------------------------------------

    if (
      !career ||
      typeof career !== 'object' ||
      !career.name
    ) {
      return res.status(400).json({
        error:
          'Career result is required.',
      })
    }

    // --------------------------------------------------------
    // Validate match percentage
    // --------------------------------------------------------

    if (
      !Number.isFinite(
        Number(matchPercent)
      )
    ) {
      return res.status(400).json({
        error:
          'A valid career match percentage is required.',
      })
    }

    // --------------------------------------------------------
    // Normalize interests
    // --------------------------------------------------------

    let normalizedInterests = []

    if (Array.isArray(selectedInterests)) {
      normalizedInterests =
        selectedInterests
    } else if (
      typeof selectedInterests === 'string'
    ) {
      try {
        const parsed =
          JSON.parse(selectedInterests)

        normalizedInterests =
          Array.isArray(parsed)
            ? parsed
            : [selectedInterests]
      } catch {
        normalizedInterests = [
          selectedInterests,
        ]
      }
    } else if (
      selectedInterests !== null &&
      selectedInterests !== undefined
    ) {
      normalizedInterests = [
        selectedInterests,
      ]
    }

    // --------------------------------------------------------
    // IMPORTANT JSON FIX
    //
    // PostgreSQL JSON/JSONB columns require:
    //
    // ["Performing Arts"]
    //
    // NOT:
    //
    // {"Performing Arts"}
    // --------------------------------------------------------

    const interestsJson =
      JSON.stringify(
        normalizedInterests
      )

    const careerJson =
      JSON.stringify(career)

    // --------------------------------------------------------
    // Save career result
    // --------------------------------------------------------

    const result = await query(
      `
      INSERT INTO career_results
        (
          user_id,
          selected_interests,
          input_text,
          career,
          match_percent
        )
      VALUES
        ($1, $2::jsonb, $3, $4::jsonb, $5)
      RETURNING
        id,
        created_at
      `,
      [
        req.auth.sub,
        interestsJson,
        inputText || '',
        careerJson,
        Number(matchPercent),
      ]
    )

    // --------------------------------------------------------
    // Save activity
    // --------------------------------------------------------

    await query(
      `
      INSERT INTO activities
        (user_id, type, meta)
      VALUES
        ($1, $2, $3)
      `,
      [
        req.auth.sub,
        'career',
        {
          career: career.name,
          pct: Number(matchPercent),
        },
      ]
    )

    // --------------------------------------------------------
    // Return result
    // --------------------------------------------------------

    res.status(201).json({
      result: {
        id: result.rows[0].id,
        career,
        pct: Number(matchPercent),
        at: result.rows[0].created_at,
      },
    })
  })
)

app.get(
  '/api/career/results/latest',
  requireAuth,
  asyncRoute(async (req, res) => {
    const result = await query(
      `
      SELECT
        career,
        match_percent AS pct,
        created_at AS at
      FROM career_results
      WHERE user_id = $1
      ORDER BY created_at DESC
      LIMIT 1
      `,
      [req.auth.sub]
    )

    if (!result.rows[0]) {
      return res.json({
        result: null,
      })
    }

    const careerData =
      result.rows[0].career

    /*
     * Depending on PostgreSQL/client configuration,
     * JSONB may already be parsed into an object.
     *
     * This makes the endpoint work safely either way.
     */
    let career

    if (
      typeof careerData === 'string'
    ) {
      try {
        career = JSON.parse(
          careerData
        )
      } catch {
        career = {
          name: careerData,
        }
      }
    } else {
      career = careerData || {}
    }

    res.json({
      result: {
        ...career,
        pct: result.rows[0].pct,
        at: result.rows[0].at,
      },
    })
  })
)

