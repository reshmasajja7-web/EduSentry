app.get(
  '/api/career/progress',
  requireAuth,
  asyncRoute(async (req, res) => {
    const result = await query(
      `
      SELECT
        xp,
        roadmap_step AS "roadmapStep",
        selected_career AS "selectedCareer",
        achievements
      FROM career_progress
      WHERE user_id = $1
      LIMIT 1
      `,
      [req.auth.sub]
    )

    if (!result.rowCount) {
      return res.json({
        progress: {
          xp: 2450,
          roadmapStep: 0,
          selectedCareer: null,
          achievements: [],
        },
      })
    }

    const row = result.rows[0]
    res.json({
      progress: {
        xp: Number(row.xp),
        roadmapStep: Number(row.roadmapStep),
        selectedCareer: row.selectedCareer || null,
        achievements: Array.isArray(row.achievements) ? row.achievements : [],
      },
    })
  })
)

app.put(
  '/api/career/progress',
  requireAuth,
  asyncRoute(async (req, res) => {
    const xp = Math.max(0, Math.floor(Number(req.body.xp ?? 2450)))
    const roadmapStep = Math.max(0, Math.floor(Number(req.body.roadmapStep ?? 0)))
    const selectedCareer = req.body.selectedCareer ? String(req.body.selectedCareer).slice(0, 160) : null
    const achievements = Array.isArray(req.body.achievements) ? req.body.achievements : []

    const result = await query(
      `
      INSERT INTO career_progress
        (user_id, xp, roadmap_step, selected_career, achievements, updated_at)
      VALUES
        ($1, $2, $3, $4, $5::jsonb, NOW())
      ON CONFLICT (user_id)
      DO UPDATE SET
        xp = EXCLUDED.xp,
        roadmap_step = EXCLUDED.roadmap_step,
        selected_career = EXCLUDED.selected_career,
        achievements = EXCLUDED.achievements,
        updated_at = NOW()
      RETURNING
        xp,
        roadmap_step AS "roadmapStep",
        selected_career AS "selectedCareer",
        achievements
      `,
      [req.auth.sub, xp, roadmapStep, selectedCareer, JSON.stringify(achievements)]
    )

    if (selectedCareer) {
      await query(
        `UPDATE users SET career_goal = $1 WHERE id = $2`,
        [selectedCareer, req.auth.sub]
      ).catch((err) => console.warn('Could not update user career_goal:', err.message))

      // Also ensure a career_results entry exists for this selected career
      await query(
        `
        INSERT INTO career_results
          (user_id, selected_interests, input_text, career, match_percent)
        VALUES
          ($1, '[]'::jsonb, '', $2::jsonb, 95)
        `,
        [req.auth.sub, JSON.stringify({ name: selectedCareer })]
      ).catch((err) => console.warn('Could not insert career_result:', err.message))
    }

    const row = result.rows[0]
    res.json({
      progress: {
        xp: Number(row.xp),
        roadmapStep: Number(row.roadmapStep),
        selectedCareer: row.selectedCareer || null,
        achievements: Array.isArray(row.achievements) ? row.achievements : [],
      },
    })
  })
)

