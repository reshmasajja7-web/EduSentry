// ============================================================
// ENGAGEMENT & STREAK COMPUTATION
// ============================================================

async function computeUserEngagement(userId) {
  const quizzes = await query(
    `
    SELECT score, total
    FROM quiz_results
    WHERE user_id = $1
    ORDER BY created_at DESC
    LIMIT 20
    `,
    [userId]
  )

  const activities = await query(
    `
    SELECT type, created_at
    FROM activities
    WHERE user_id = $1
    ORDER BY created_at DESC
    LIMIT 1000
    `,
    [userId]
  )

  const sessions = await query(
    `
    SELECT started_at, ended_at, duration_seconds
    FROM study_sessions
    WHERE user_id = $1
      AND started_at >= NOW() - INTERVAL '30 days'
    ORDER BY started_at DESC
    `,
    [userId]
  )

  const quizAverage = quizzes.rowCount
    ? Math.round(
        quizzes.rows.reduce(
          (sum, q) => sum + (Number(q.score) / Number(q.total)) * 100,
          0
        ) / quizzes.rowCount
      )
    : 0

  const today = new Date()
  const dateKey = (value) => new Date(value).toISOString().slice(0, 10)
  const daysAgo = (days) => {
    const d = new Date(today)
    d.setDate(d.getDate() - days)
    return d
  }
  const startOfTodayUtc = new Date(today)
  startOfTodayUtc.setUTCHours(0, 0, 0, 0)

  const sessionDates = new Set(sessions.rows.map((s) => dateKey(s.started_at)))
  const activityDates = new Set(activities.rows.map((a) => dateKey(a.created_at)))
  const activeDates = new Set([...sessionDates, ...activityDates])

  const recent14Start = new Date(startOfTodayUtc)
  recent14Start.setUTCDate(recent14Start.getUTCDate() - 13)
  const recent14Dates = new Set(
    [...activeDates].filter((day) => new Date(`${day}T00:00:00Z`) >= recent14Start)
  )
  const studyConsistency = Math.round((recent14Dates.size / 14) * 100)

  let studyStreak = 0
  const streakCursor = new Date(today)
  const todayKey = dateKey(today)
  if (!activeDates.has(todayKey)) {
    streakCursor.setDate(streakCursor.getDate() - 1)
  }
  while (activeDates.has(dateKey(streakCursor))) {
    studyStreak += 1
    streakCursor.setDate(streakCursor.getDate() - 1)
  }

  const last7Start = daysAgo(6)
  const weeklySeconds = sessions.rows
    .filter((s) => new Date(s.started_at) >= last7Start)
    .reduce((sum, s) => sum + Number(s.duration_seconds || 0), 0)
  const studyHours = Math.round((weeklySeconds / 3600 / 7) * 100) / 100

  const revisionDates = new Set(
    activities.rows
      .filter((a) => a.type === 'flashcards')
      .map((a) => dateKey(a.created_at))
  )
  const recent30Start = new Date(startOfTodayUtc)
  recent30Start.setUTCDate(recent30Start.getUTCDate() - 29)
  const recentActive30 = [...activeDates].filter(
    (day) => new Date(`${day}T00:00:00Z`) >= recent30Start
  )
  const revisionFrequency = recentActive30.length
    ? Math.round(
        (recentActive30.filter((day) => revisionDates.has(day)).length /
          recentActive30.length) *
          100
      )
    : 0

  const tutorInteractions = activities.rows.filter(
    (a) => a.type === 'tutor_interaction'
  ).length

  const learningActivityTypes = new Set(
    activities.rows
      .map((a) => a.type)
      .filter((type) =>
        ['upload', 'tutor_interaction', 'summary', 'flashcards', 'quiz'].includes(type)
      )
  )
  const topicsCompleted = Math.round(
    (learningActivityTypes.size / 5) * 100
  )

  return {
    quizAverage,
    quizzesCount: quizzes.rowCount,
    studyHours,
    topicsCompleted,
    studyConsistency,
    revisionFrequency,
    studyStreak,
    aiTutorInteractions: tutorInteractions,
    metricsSource: 'PostgreSQL platform activity and study sessions',
  }
}

// ============================================================
// DASHBOARD
// ============================================================

/*
 * Dashboard summary endpoint.
 *
 * Reads real-time PostgreSQL data across all modules:
 * indexed document count, latest risk assessment, active selected career target,
 * and synchronized study streak.
 */
app.get(
  '/api/dashboard/summary',
  requireAuth,
  asyncRoute(async (req, res) => {
    const userId = req.auth.sub

    const result = await query(
      `
      WITH document_stats AS (
        SELECT COUNT(*)::INTEGER AS count
        FROM documents
        WHERE user_id = $1
          AND is_sample = FALSE
          AND status = 'indexed'
      ),
      latest_risk AS (
        SELECT
          risk_level AS level,
          risk_score AS score
        FROM risk_predictions
        WHERE user_id = $1
        ORDER BY created_at DESC
        LIMIT 1
      ),
      latest_career AS (
        SELECT
          career,
          match_percent AS pct
        FROM career_results
        WHERE user_id = $1
        ORDER BY created_at DESC
        LIMIT 1
      ),
      career_prog AS (
        SELECT selected_career
        FROM career_progress
        WHERE user_id = $1
        LIMIT 1
      ),
      usr_info AS (
        SELECT career_goal
        FROM users
        WHERE id = $1
        LIMIT 1
      )
      SELECT
        (SELECT count FROM document_stats) AS "documentCount",
        (SELECT row_to_json(latest_risk) FROM latest_risk) AS risk,
        (SELECT row_to_json(latest_career) FROM latest_career) AS career,
        (SELECT selected_career FROM career_prog) AS "selectedCareer",
        (SELECT career_goal FROM usr_info) AS "careerGoal"
      `,
      [userId]
    )

    const row = result.rows[0] || {}

    let risk = row.risk || null
    let career = row.career || null

    if (typeof risk === 'string') {
      try {
        risk = JSON.parse(risk)
      } catch {
        risk = null
      }
    }

    if (typeof career === 'string') {
      try {
        career = JSON.parse(career)
      } catch {
        career = null
      }
    }

    // Prioritize the user's explicitly selected career from Career Guidance
    const activeSelectedCareer = row.selectedCareer || row.careerGoal || null
    if (activeSelectedCareer) {
      const careerName = career?.career?.name || career?.career || career?.name
      if (!career || careerName !== activeSelectedCareer) {
        career = {
          name: activeSelectedCareer,
          career: { name: activeSelectedCareer },
          pct: career?.pct || 94,
        }
      }
    }

    const docsResult = await query(
      `
      SELECT id, name, size_label, status, created_at
      FROM documents
      WHERE user_id = $1
        AND is_sample = FALSE
      ORDER BY created_at DESC
      LIMIT 8
      `,
      [userId]
    )

    const sessionsResult = await query(
      `
      SELECT started_at, duration_seconds
      FROM study_sessions
      WHERE user_id = $1
        AND started_at >= NOW() - INTERVAL '30 days'
      ORDER BY started_at ASC
      `,
      [userId]
    )

    const engagement = await computeUserEngagement(userId)

    res.json({
      documentCount: Number(row.documentCount || 0),
      documents: docsResult.rows,
      recentSessions: sessionsResult.rows,
      risk,
      career,
      engagement,
      streak: engagement.studyStreak,
      studyStreak: engagement.studyStreak,
      studyHours: engagement.studyHours,
      quizzes: engagement.quizzesCount,
    })
  })
)

