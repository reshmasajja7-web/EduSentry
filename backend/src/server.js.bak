app.post(
  '/api/earlyrisk/predict',
  optionalAuth,
  asyncRoute(async (req, res) => {
    const {
      userType,
      academicData = {},
      engagementData,
    } = req.body

    if (
      !['college', 'self-paced'].includes(
        userType
      )
    ) {
      return res.status(400).json({
        error:
          'userType must be college or self-paced.',
      })
    }

    const finalEngagement =
      engagementData ||
      getDefaultEngagement()

    const result = predictRisk({
      userType,
      academicData,
      engagementData: finalEngagement,
    })

    let savedId = 'pred-' + Date.now()
    let createdAt = new Date().toISOString()

    if (req.auth?.sub) {
      const saved = await query(
        `
        INSERT INTO risk_predictions
          (
            user_id,
            user_type,
            academic_data,
            engagement_data,
            result,
            risk_score,
            risk_level,
            confidence
          )
        VALUES
          ($1, $2, $3, $4, $5, $6, $7, $8)
        RETURNING
          id,
          created_at
        `,
        [
          req.auth.sub,
          userType,
          toJson(academicData, {}),
          toJson(finalEngagement, {}),
          toJson(result, {}),
          result.riskScore,
          result.riskLevel,
          result.confidence,
        ]
      )

      await query(
        `
        INSERT INTO activities
          (user_id, type, meta)
        VALUES
          ($1, $2, $3)
        `,
        [
          req.auth.sub,
          'risk',
          {
            level: result.riskLevel,
            score: result.riskScore,
          },
        ]
      )

      savedId = saved.rows[0].id
      createdAt = saved.rows[0].created_at
    }

    res.json({
      prediction: {
        ...result,
        id: savedId,
        createdAt,
      },
    })
  })
)

