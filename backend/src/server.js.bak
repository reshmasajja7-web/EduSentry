app.post(
  '/api/study-sessions',
  requireAuth,
  asyncRoute(async (req, res) => {
    const { startedAt, endedAt, durationSeconds } = req.body

    const start = new Date(startedAt)
    const end = new Date(endedAt)
    const duration = Number(durationSeconds)

    if (
      Number.isNaN(start.getTime()) ||
      Number.isNaN(end.getTime()) ||
      end < start ||
      !Number.isFinite(duration) ||
      duration < 1 ||
      duration > 12 * 60 * 60
    ) {
      return res.status(400).json({
        error: 'A valid study session duration is required.',
      })
    }

    const result = await query(
      `
      INSERT INTO study_sessions
        (user_id, started_at, ended_at, duration_seconds)
      VALUES
        ($1, $2, $3, $4)
      RETURNING id, started_at, ended_at, duration_seconds, created_at
      `,
      [req.auth.sub, start.toISOString(), end.toISOString(), Math.round(duration)]
    )

    res.status(201).json({ session: result.rows[0] })
  })
)

